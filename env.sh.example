# Copy to env.sh and edit. Sourced by submit.sh and sbatch jobs.
#   cp env.sh.example env.sh
#
# Keep env.sh out of git — it holds local paths and optional email.
# Never commit usernames, emails, or absolute /data/.../$USER paths.

# Consumer project checkout on ARC (under $DATA) or on your laptop.
# Required when this toolkit is a standalone clone. When nested as
# <repo>/scripts/cluster/oxford-arc, REPO_ROOT is inferred automatically.
# export REPO_ROOT="${REPO_ROOT:-$DATA/my-project}"

# Optional alias used by older pe-hub scripts (same meaning as REPO_ROOT).
# export PE_HUB_ROOT="${PE_HUB_ROOT:-$REPO_ROOT}"

# ARC project share name (the segment after /data/). Override for your group.
export ARC_PROJECT="${ARC_PROJECT:-YOUR_ARC_PROJECT}"

# Conda via ARC modules (recommended). Discover with: module spider Anaconda / Mamba
export ARC_MODULES="${ARC_MODULES:-Anaconda3}"
# Prefix under $DATA (not a named env in $HOME — HOME is only ~15 GiB).
export CONDA_ENV="${CONDA_ENV:-$DATA/envs/my-project}"
# Optional private Miniconda instead of the module:
# unset ARC_MODULES
# export CONDA_ROOT="$DATA/conda"

# Optional extra modules (space-separated), e.g. CUDA if needed for builds.
# export ARC_MODULES="Anaconda3 CUDA/12.2"

# Optional pe-hub profile hooks (install CLIs, verify imports). Leave unset for
# generic jobs that only need conda + your STAGE_SCRIPT.
# export ARC_PROFILE=pe-hub

# SLURM defaults for GPU jobs on htc (GPUs are not on the arc cluster).
# short ≤12h (faster start); medium ≤48h; long ≤30d
export ARC_CLUSTER="${ARC_CLUSTER:-htc}"
export ARC_PARTITION="${ARC_PARTITION:-short}"
export ARC_TIME="${ARC_TIME:-12:00:00}"
export ARC_GPUS="${ARC_GPUS:-1}"
# Prefer L40S (large pool). Unset to accept any GPU.
export ARC_GPU_CONSTRAINT="${ARC_GPU_CONSTRAINT:-gpu_sku:L40S}"
export ARC_CPUS="${ARC_CPUS:-8}"
export ARC_MEM="${ARC_MEM:-64G}"
# Optional END/FAIL mail — set your own address locally, never commit it.
export ARC_MAIL_USER="${ARC_MAIL_USER:-}"

# Job device (single GPU → cuda:0 inside the allocation)
export DEVICE="${DEVICE:-cuda:0}"
export N_TRIALS="${N_TRIALS:-10}"
export N_SEEDS="${N_SEEDS:-3}"
export PROTOCOL="${PROTOCOL:-holdout_3}"
export CV_FOLDS="${CV_FOLDS:-5}"
export SMOKE="${SMOKE:-0}"
export SKIP_IF_TUNED="${SKIP_IF_TUNED:-0}"
export SKIP_IF_DONE="${SKIP_IF_DONE:-0}"

# Laptop ↔ ARC artifacts: rsync (no git commits). Run on the laptop:
#   ./bin/pull.sh                # prompts for ARC username
#   ./bin/push.sh YOUR_ARC_USER
# Paths = every *.dvc out under REPO_ROOT plus this toolkit's env.sh.
