# Example SSH config for Oxford ARC (no usernames — fill in YOUR_ARC_USER).
#
# On University network / VPN:
#   Host htc-login
#     HostName htc-login.arc.ox.ac.uk
#     User YOUR_ARC_USER
#
# Off-campus via gateway:
#   Host arc-gateway
#     HostName gateway.arc.ox.ac.uk
#     User YOUR_ARC_USER
#
#   Host htc-login
#     HostName htc-login.arc.ox.ac.uk
#     User YOUR_ARC_USER
#     ProxyJump arc-gateway
